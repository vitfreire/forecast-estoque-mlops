MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=forecast_estoque_walmart
MLFLOW_REGISTERED_MODEL_NAME=walmart_forecast_lgbm_cost

# Horizonte de inferência batch (dias)
HORIZON_DAYS=28

# Função de custo assimétrica:
# COST_UNDER = custo de ruptura (subprevisão) — penaliza mais pois venda perdida é irrecuperável
# COST_OVER  = custo de estoque parado (superprevisão)
COST_UNDER=6.0
COST_OVER=1.5

# Caminhos de dados e saídas
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
REPORTS_DIR=reports
MODELS_DIR=models
